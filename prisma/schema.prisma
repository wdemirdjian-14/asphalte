// Asphalte — schéma de données MVP
// Dépannage & réparation 2 roues, Boulogne-Billancourt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Backoffice / utilisateurs
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MECANICIEN
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  receptions        Reception[]
  stockMovements    StockMovement[]
  messageReplies    MessageReply[]
  pushSubscriptions PushSubscription[]
}

// ---------------------------------------------------------------------------
// Contenu éditorial de la page publique (administrable depuis le backoffice)
// ---------------------------------------------------------------------------

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum MediaKind {
  GARAGE
  ATELIER
  EQUIPE
  REALISATION
  AUTRE
}

model MediaAsset {
  id        String    @id @default(cuid())
  url       String
  alt       String    @default("")
  kind      MediaKind @default(AUTRE)
  position  Int       @default(0)
  published Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([kind, position])
}

// ---------------------------------------------------------------------------
// Messages reçus depuis le widget de contact
// ---------------------------------------------------------------------------

enum MessageStatus {
  NOUVEAU
  LU
  TRAITE
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String?
  plate     String?
  subject   String?
  message   String
  status    MessageStatus @default(NOUVEAU)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  replies MessageReply[]

  @@index([status, createdAt])
}

/// Réponse de l'atelier à un message du site. Conservée même si l'envoi
/// e-mail échoue : le fil reste complet, l'échec est visible.
model MessageReply {
  id         String         @id @default(cuid())
  messageId  String
  message    ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  body       String
  authorId   String?
  author     AdminUser?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  emailSent  Boolean        @default(false)
  emailError String?
  createdAt  DateTime       @default(now())

  @@index([messageId, createdAt])
}

/// Abonnement Web Push d'un appareil. Sur iPhone, l'abonnement n'existe
/// que si le site a été ajouté à l'écran d'accueil (iOS 16.4 minimum).
model PushSubscription {
  id         String     @id @default(cuid())
  endpoint   String     @unique
  p256dh     String
  auth       String
  userId     String?
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String     @default("")
  label      String     @default("")
  createdAt  DateTime   @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Vue 360 client
// ---------------------------------------------------------------------------

model Client {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  company    String?
  email      String?
  phone      String
  phone2     String?
  address    String?
  postalCode String?
  city       String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicles      Vehicle[]
  interventions Intervention[]
  sales         Sale[]

  @@index([lastName, firstName])
  @@index([phone])
}

model Vehicle {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Plaque normalisée (majuscules, sans espace ni tiret) — sert à la recherche
  plate        String
  plateDisplay String
  brand        String
  model        String
  year         Int?
  displacement Int?
  vin          String?
  color        String?
  mileage      Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interventions Intervention[]
  documents     VehicleDocument[]

  @@index([plate])
  @@index([brand, model])
}

enum VehicleDocumentKind {
  CARTE_GRISE
  ASSURANCE
  FACTURE
  PHOTO
  AUTRE
}

/// Documents scannés ou photographiés d'un véhicule — la carte grise en
/// premier lieu, pour ne plus avoir à la redemander au client.
model VehicleDocument {
  id        String              @id @default(cuid())
  vehicleId String
  vehicle   Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  kind      VehicleDocumentKind @default(CARTE_GRISE)
  label     String              @default("")
  createdAt DateTime            @default(now())

  @@index([vehicleId, kind])
}

enum InterventionType {
  DEPANNAGE
  REPARATION
  ENTRETIEN
  DIAGNOSTIC
}

enum InterventionStatus {
  OUVERT
  EN_COURS
  TERMINE
  FACTURE
  ANNULE
}

model Intervention {
  id          String             @id @default(cuid())
  reference   String             @unique
  type        InterventionType   @default(DEPANNAGE)
  status      InterventionStatus @default(OUVERT)
  title       String
  description String?
  clientId    String
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicleId   String?
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Spécifique dépannage
  pickupLocation  String?
  dropoffLocation String?

  scheduledAt DateTime?
  completedAt DateTime?
  mileage     Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parts          InterventionPart[]
  services       InterventionService[]
  stockMovements StockMovement[]

  @@index([clientId, createdAt])
  @@index([status])
}

/// Pièce montée sur l'intervention. Sortie du stock si elle vient du catalogue.
model InterventionPart {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  label          String
  quantity       Int          @default(1)

  @@index([interventionId])
}

enum ServiceCategory {
  ENTRETIEN
  FREINAGE
  PNEUMATIQUE
  MOTEUR
  TRANSMISSION
  ELECTRIQUE
  CONTROLE
  AUTRE
}

/// Catalogue des prestations de l'atelier : ce sont les cases à cocher
/// proposées sur une révision.
model ServiceTask {
  id       String          @id @default(cuid())
  name     String          @unique
  category ServiceCategory @default(ENTRETIEN)
  position Int             @default(0)
  active   Boolean         @default(true)

  interventions InterventionService[]

  @@index([category, position])
}

/// Prestation réellement effectuée sur une intervention.
model InterventionService {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  serviceTaskId  String?
  serviceTask    ServiceTask? @relation(fields: [serviceTaskId], references: [id], onDelete: SetNull)
  label          String
  notes          String?
  createdAt      DateTime     @default(now())

  @@unique([interventionId, label])
  @@index([interventionId])
}

// ---------------------------------------------------------------------------
// Ventes d'accessoires / produits au comptoir
// ---------------------------------------------------------------------------

/// Produits remis au client au comptoir (accessoires, consommables).
/// L'atelier ne gère pas les prix ici : on trace ce qui est sorti, pas
/// combien ça a été facturé.
model Sale {
  id        String   @id @default(cuid())
  reference String   @unique
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  soldAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  lines          SaleLine[]
  stockMovements StockMovement[]

  @@index([clientId, soldAt])
}

model SaleLine {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  label     String
  quantity  Int      @default(1)

  @@index([saleId])
}

// ---------------------------------------------------------------------------
// Catalogue produits & stock
// ---------------------------------------------------------------------------

enum ProductCategory {
  PIECE
  ACCESSOIRE
  PNEU
  LUBRIFIANT
  EQUIPEMENT
  CONSOMMABLE
  AUTRE
}

/// Un produit, c'est une photo, un nom et une quantité en stock.
/// Le reste est facultatif : l'atelier ne gère ni prix ni TVA.
model Product {
  id         String          @id @default(cuid())
  sku        String          @unique
  name       String
  notes      String?
  category   ProductCategory @default(AUTRE)
  brand      String?
  location   String?
  stockQty   Int             @default(0)
  stockAlert Int             @default(0)
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  photos            ProductPhoto[]
  movements         StockMovement[]
  receptionLines    ReceptionLine[]
  interventionParts InterventionPart[]
  saleLines         SaleLine[]

  @@index([name])
  @@index([category, active])
}

model ProductPhoto {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  receptions Reception[]
}

enum ReceptionStatus {
  BROUILLON
  VALIDE
}

/// Un colis reçu au garage. On saisit toutes les lignes puis on valide :
/// l'entrée en stock se fait en une seule fois, avec traçabilité complète.
model Reception {
  id             String          @id @default(cuid())
  reference      String          @unique
  status         ReceptionStatus @default(BROUILLON)
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  carrier        String?
  trackingNumber String?
  packageCount   Int             @default(1)
  receivedAt     DateTime        @default(now())
  validatedAt    DateTime?
  receivedById   String?
  receivedBy     AdminUser?      @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  lines     ReceptionLine[]
  movements StockMovement[]

  @@index([status, receivedAt])
  @@index([trackingNumber])
}

model ReceptionLine {
  id          String    @id @default(cuid())
  receptionId String
  reception   Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  notes       String?

  @@index([receptionId])
}

enum MovementType {
  RECEPTION
  VENTE
  INTERVENTION
  AJUSTEMENT
  RETOUR
  INVENTAIRE
}

/// Journal immuable des mouvements de stock : qui, quand, pourquoi, et
/// l'état du stock avant/après. C'est la source de vérité de la traçabilité.
model StockMovement {
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           MovementType
  /// Signé : positif pour une entrée, négatif pour une sortie
  quantity       Int
  stockBefore    Int
  stockAfter     Int
  reason         String?
  receptionId    String?
  reception      Reception?    @relation(fields: [receptionId], references: [id], onDelete: SetNull)
  saleId         String?
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  interventionId String?
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  userId         String?
  user           AdminUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userLabel      String        @default("système")
  createdAt      DateTime      @default(now())

  @@index([productId, createdAt])
  @@index([type, createdAt])
}
