# --- Base de données ---
DATABASE_URL="postgresql://asphalte:asphalte@localhost:5432/asphalte?schema=public"

# --- Sécurité backoffice ---
# Générer avec: openssl rand -hex 32
AUTH_SECRET="changez-moi-par-une-chaine-aleatoire-de-32-octets-minimum"

# --- Compte administrateur créé par le seed ---
SEED_ADMIN_EMAIL="contact@asphalte.fr"
SEED_ADMIN_PASSWORD="asphalte2002"
SEED_ADMIN_NAME="Atelier Asphalte"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://asphalte.walautao.fr"

# --- Envoi d'e-mails (IONOS) ---
SMTP_HOST="smtp.ionos.fr"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contact@asphalte.walautao.fr"
SMTP_PASSWORD="le-mot-de-passe-de-la-boite-mail"
MAIL_FROM="Asphalte <contact@asphalte.walautao.fr>"
# Adresse prévenue à l'arrivée d'un message du site (défaut : SMTP_USER)
MAIL_TO_ATELIER="contact@asphalte.walautao.fr"

# --- Notifications push (PWA iPhone) ---
# Générer la paire avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@asphalte.walautao.fr"
